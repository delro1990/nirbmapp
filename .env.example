# --- Required ---------------------------------------------------------------
# ID of your Google Sheet: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Service account (Google Cloud) that has EDITOR access to the Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=budget-monitor@your-project.iam.gserviceaccount.com
# "private_key" value from the service-account JSON key (keep the \n sequences, or paste real line breaks)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Long random string used to sign login cookies:  openssl rand -hex 32
SESSION_SECRET=

# --- Optional: password-reset emails (https://resend.com – free tier) -------
RESEND_API_KEY=
MAIL_FROM=Budget Monitor <noreply@yourdomain.com>

# --- Optional: "Sign in with Google" for admins listed under Admin > Google email
# OAuth 2.0 Web client ID (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
